{
  "name": "@ecomaster/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/workerd-runtime.mts",
    "dev": "cf dev",
    "start": "cf dev",
    "build": "cf build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check": "node scripts/check-tenancy.mjs && vitest run && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "deploy": "node scripts/deploy.mts",
    "db:generate": "drizzle-kit generate",
    "db:create": "cf d1 create --name ecomaster-db",
    "db:local": "cf d1 migrations apply 0352d618-75f0-4803-9531-e27ce0fb0f59 --local --dir migrations --persist-to .wrangler/state",
    "db:remote": "cf d1 migrations apply 0352d618-75f0-4803-9531-e27ce0fb0f59 --dir migrations",
    "catalog:seed": "node scripts/import-products.mts",
    "catalog:seed:local": "node scripts/apply-products-seed.mts --local",
    "catalog:seed:remote": "node scripts/apply-products-seed.mts --remote",
    "r2:create": "cf r2 buckets create-by-name ecomaster-storage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.11",
    "@ecomaster/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^22.10.1",
    "@types/sql.js": "^1.4.11",
    "cf": "1.0.0-beta.13",
    "drizzle-kit": "^0.31.11",
    "sql.js": "^1.15.1",
    "typescript": "^5.9.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.136.0"
  }
}
