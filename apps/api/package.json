{
  "name": "@tools/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/workerd-runtime.mts",
    "dev": "cf dev",
    "start": "cf dev",
    "build": "cf build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "deploy": "node scripts/deploy.mts",
    "db:generate": "drizzle-kit generate",
    "db:create": "cf d1 create --name tools-db",
    "db:local": "cf d1 migrations apply 584af39d-eb80-486e-8b85-abe9e46b530d --local --dir migrations --persist-to .wrangler/state",
    "db:remote": "cf d1 migrations apply 584af39d-eb80-486e-8b85-abe9e46b530d --dir migrations",
    "r2:create": "cf r2 buckets create-by-name tools-storage"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.11",
    "@hono/zod-validator": "^0.9.1",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tools/shared": "workspace:*",
    "better-auth": "^1.7.11",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.9.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^22.10.1",
    "cf": "1.0.0-beta.13",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.0"
  }
}
