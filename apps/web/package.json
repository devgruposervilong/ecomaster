{
  "name": "@tools/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "preview": "vite preview",
    "pwa:icons": "pwa-assets-generator && node scripts/pwa-icons.mts",
    "pwa:splash": "node scripts/pwa-splash.mts",
    "pwa:monochrome": "node scripts/monochrome-logo.mts",
    "pwa:assets": "pnpm pwa:monochrome && pnpm pwa:icons && pnpm pwa:splash"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^2.0.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
